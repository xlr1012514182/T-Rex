{
  "schema_version": "revo3-v1-control-v1",
  "runtime": {
    "control_watchdog_ms": 100,
    "servo_io_timeout_ms": 50,
    "io_close_timeout_ms": 1000
  },
  "emg": {
    "backbone": "GNI-derived",
    "gni_source_repository": "https://github.com/facebookresearch/generic-neuromotor-interface",
    "gni_source_commit": "b6bf250e2be5a67b23488104335373cdb87a15c9",
    "gni_checkpoint_required": true,
    "from_scratch_is_ablation_only": true,
    "preprocessing": {
      "profile_id": "brainco_edu_8ch_250hz_hp40_v1",
      "channel_count": 8,
      "sample_rate_hz": 250,
      "highpass_hz": 40.0,
      "highpass_order": 4,
      "filter": "butterworth_sos_causal",
      "window_samples": 500,
      "stride_samples_pattern": [12, 13],
      "real_training_requires_session_continuous_filtering": true
    },
    "window_context_s": 2.0,
    "inference_stride_ms": 50,
    "learned_classes": [
      "POWER_GRASP",
      "PRECISION_GRASP",
      "LATERAL_GRASP",
      "RELEASE",
      "REST"
    ],
    "derived_states": ["UNKNOWN", "BAD_SIGNAL"],
    "start_confidence": 0.8,
    "start_margin": 0.2,
    "start_dwell_ms": 300,
    "release_confidence": 0.9,
    "release_margin": 0.3,
    "release_dwell_ms": 500,
    "min_signal_quality": 0.8,
    "max_update_gap_ms": 150,
    "raw_emg_to_vla": false,
    "rest_cancels_task": false
  },
  "planner": {
    "base_model": "Qwen/Qwen3-VL-2B-Instruct",
    "base_revision": "89644892e4d85e24eaac8bacfd4f463576704203",
    "production_requires_lora_adapter": true,
    "adapter_manifest_schema": "revo3-planner-lora-adapter-v1",
    "processor_schema": "revo3-qwen3vl-processor-v1",
    "schema_version": "planner_v1",
    "full_view_history": 3,
    "center_view_current": 1,
    "views_share_current_timestamp": true,
    "repair_retries": 1,
    "instruction_max_tokens": 25,
    "max_new_tokens": 384,
    "temperature": 0,
    "lora": {
      "rank": 16,
      "alpha": 32,
      "dropout": 0.05,
      "learning_rate": 0.00005,
      "epochs_max": 3,
      "effective_batch_range": [32, 64],
      "precision": "bf16",
      "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"]
    }
  },
  "executive": {
    "outputs": ["WAIT", "START", "CONTINUE", "HOLD", "REPLAN", "COMPLETE", "ABORT"],
    "replan_only_before_contact": true,
    "max_replans": 1,
    "stable_grasp_output": "HOLD",
    "release_requires_touch_unloaded_and_safe_open": true,
    "commit_stability_ms": 150,
    "tactile_profile_readiness": {
      "A_force6d_history_frames": 16,
      "B_diff_valid_fingers": 5,
      "C_requires_pressure_and_valid_mask": true,
      "C_requires_validated_policy_adapter": true,
      "C_default_enabled": false
    },
    "touch_stale_abort_ms": 500,
    "camera_stale_abort_ms": 1000,
    "policy_stale_abort_ms": 1000,
    "policy_startup_abort_ms": 3000,
    "policy_ttl_ms": 750,
    "slow_response_observation_budget_ms": 1500,
    "fast_response_observation_budget_ms": 500,
    "lease_ttl_ms": 3000,
    "release_timeout_ms": 3000,
    "allowed_future_skew_ms": 5,
    "emg_start_ttl_ms": 3000,
    "planner_ttl_ms": 1000,
    "planner_sla_ms": 20000,
    "planner_source_max_age_ms": 18000,
    "planner_scene_max_distance": 0.08,
    "pending_intent_ttl_ms": 22000,
    "camera_ttl_ms": 100,
    "state_ttl_ms": 50,
    "touch_ttl_ms": 150
  }
}
